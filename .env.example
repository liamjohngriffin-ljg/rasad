# Copy to .env and fill in. Only the first two lines are required.
RASAD_DB_PASSWORD=change-me-to-something-long
# Hostname pointing at this server (A record). Caddy obtains a certificate automatically.
# Leave empty for plain HTTP on port 80 while testing.
DOMAIN=

# First admin account, created once when the users table is empty.
RASAD_ADMIN_USERNAME=admin
# Leave empty to have a password generated and written to the data volume (admin-password.txt).
RASAD_ADMIN_PASSWORD=

# Session signing key. Leave empty to generate one in the data volume.
RASAD_SECRET=

# Extraction and brief polish: rules (no model, always works) | anthropic | local (OpenAI-compatible endpoint)
RASAD_MODEL_PROVIDER=rules
ANTHROPIC_API_KEY=
RASAD_LOCAL_MODEL_BASE_URL=
RASAD_LOCAL_MODEL_NAME=jais-2-70b-chat

# Daily pipeline time (local) and time zone
RASAD_PIPELINE_TIME=06:00
TZ=Asia/Dubai

# Backups: nightly pg_dump kept for this many days in the backups volume
RASAD_BACKUP_RETENTION_DAYS=30

# Make the calibration record readable without signing in (the published-record principle); off until it earns it.
RASAD_PUBLIC_RECORD=false

# Protective marking shown in the header and on exported briefs
RASAD_MARKING=OFFICIAL
# Licence file issued by the vendor (default <data volume>/licence.json); without it the platform runs in evaluation mode
RASAD_LICENCE_FILE=
# Alert digest by email (optional). Leave RASAD_SMTP_HOST empty to disable.
RASAD_SMTP_HOST=
RASAD_SMTP_PORT=587
RASAD_SMTP_USER=
RASAD_SMTP_PASSWORD=
RASAD_SMTP_FROM=rasad@example.org
RASAD_DIGEST_TO=
# Public URL used in digest links
RASAD_PUBLIC_URL=
