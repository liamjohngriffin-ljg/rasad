# Reverse proxy with automatic TLS. Set DOMAIN in .env to a hostname that points at this server
# and Caddy obtains and renews a Let's Encrypt certificate. With DOMAIN unset it serves plain
# HTTP on port 80 for a first look (use an SSH tunnel rather than exposing that to the internet).
{$DOMAIN::80} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# the largest legitimate upload is a logo (200 KB) or a licence file
	request_body {
		max_size 2MB
	}
	# defence in depth: the API already refuses paths outside its folders; nothing legitimate uses ".."
	@traversal expression `{http.request.uri.path}.matches("(?i)(\\.\\.|%2e)")`
	respond @traversal 400
	reverse_proxy api:8000
}
